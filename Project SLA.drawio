          <mxGeometry relative="1" x="0.7" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-71" edge="1" parent="1" source="N5xQFqpIoiPfFkRq3-xL-2" style="dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=0;startArrow=oval;startFill=0;endSize=6;startSize=4;html=1;fontSize=13;labelBackgroundColor=#ffffff;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;exitX=0.8;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="N5xQFqpIoiPfFkRq3-xL-16" value="Xác nhận&lt;br&gt;đã giải quyết">
          <mxGeometry relative="1" x="-0.45" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-72" edge="1" parent="1" source="N5xQFqpIoiPfFkRq3-xL-2" style="dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=0;startArrow=oval;startFill=0;endSize=6;startSize=4;html=1;fontSize=13;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;exitX=0.8242;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="N5xQFqpIoiPfFkRq3-xL-17" value="Từ chối&lt;br&gt;và lý do">
          <mxGeometry relative="1" x="-0.45" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-73" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="5 trạng thái: New, In Progress, Waiting for Customer,&lt;br&gt;Resolved, Closed. Event/task BPMN là bước xử lý,&lt;br&gt;không phải trạng thái thứ sáu. REVIEW_REQUIRED là&lt;br&gt;kết quả API lỗi, không dùng BPMN Error Event." vertex="1">
          <mxGeometry height="66" width="14" x="240" y="425" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-75" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Waiting pause G (SLA giải quyết); review riêng không&lt;br&gt;pause/reset/cấp thêm giờ. M-07 ghi chờ giờ lịch, phần&lt;br&gt;giao với G đang chạy trong lịch và bối cảnh breach." vertex="1">
          <mxGeometry height="51" width="14" x="1040" y="425" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-76" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Do Agent phụ trách yêu cầu;&lt;br&gt;vẫn hợp lệ khi review đang mở." vertex="1">
          <mxGeometry height="37" width="14" x="1560" y="425" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-77" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Chưa có tin nhắn&lt;br&gt;thì token chờ tại&lt;br&gt;C1; không tự&lt;br&gt;resume." vertex="1">
          <mxGeometry height="66" width="14" x="1830" y="425" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-78" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Giữ assignee, ngân sách&lt;br&gt;còn lại, vi phạm đã có;&lt;br&gt;không reset; review mở&lt;br&gt;vẫn mở." vertex="1">
          <mxGeometry height="66" width="14" x="1900" y="640" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-79" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Giả định actor hợp lệ, ticket&lt;br&gt;In Progress. Lỗi khác chỉ ghi&lt;br&gt;chú; không bypass thứ tự kiểm&lt;br&gt;tra: quyền → trạng thái → review." vertex="1">
          <mxGeometry height="66" width="14" x="1660" y="735" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-80" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Thất bại không ngắt&lt;br&gt;hoặc hủy vòng đời&lt;br&gt;ticket; sau đó chờ&lt;br&gt;hành động mới ở U2." vertex="1">
          <mxGeometry height="66" width="14" x="2200" y="430" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-81" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Nội dung này cũng hoàn tất&lt;br&gt;phản hồi đầu nếu chưa có&lt;br&gt;phản hồi công khai trước.&lt;br&gt;Kênh: ứng dụng, không&lt;br&gt;email/SMS/push." vertex="1">
          <mxGeometry height="80" width="14" x="2300" y="835" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-82" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Chưa phản hồi thì ticket vẫn Resolved; SLA giải&lt;br&gt;quyết đã dừng; không timer tự đóng. Resolved giữ&lt;br&gt;nguyên nếu không phản hồi. Closed không mở lại/&lt;br&gt;tự sửa; quyền xem vẫn theo vai trò. Customer&lt;br&gt;không thấy note, cảnh báo, escalation/review." vertex="1">
          <mxGeometry height="80" width="14" x="2520" y="915" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-83" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Giao dịch nguyên tử, không vẽ Transaction&lt;br&gt;Sub-Process. Từ chối tiếp tục ngân sách còn&lt;br&gt;lại, không reset/nhân đôi. Còn 0 trong giờ:&lt;br&gt;hạn = thời điểm resume; ngoài giờ: hạn 08:00&lt;br&gt;phiên làm việc kế tiếp (cùng ngày nếu trước&lt;br&gt;08:00 ngày làm việc); giữ breach đã có." vertex="1">
          <mxGeometry height="95" width="14" x="2860" y="905" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-84" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Ticket New chưa nhận; tải Agent &amp;lt;3. Backend kiểm tra, gán Agent,&lt;br&gt;chuyển In Progress, ghi event và snapshot tại assigned_at trong&lt;br&gt;cùng giao dịch. Yêu cầu lỗi không hoàn tất việc nhận và không&lt;br&gt;đóng ticket. Đây là bước nhận hợp lệ của vòng đời, không tạo&lt;br&gt;instance mới cho mỗi lần API thất bại. U1 chỉ hoàn tất thành&lt;br&gt;công khi backend nhận ticket hợp lệ." vertex="1">
          <mxGeometry height="95" width="14" x="440" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-85" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Customer nhắn ở New/In Progress không đổi trạng thái&lt;br&gt;hay reset SLA; Agent nhắn/note ở Waiting không resume G.&lt;br&gt;Ghi chú nội bộ, tin nhắn Customer không là phản hồi đầu.&lt;br&gt;Hoạt động phụ chỉ chú thích, không vẽ hết event handler." vertex="1">
          <mxGeometry height="66" width="14" x="900" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-86" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Hai Agent cùng nhận một ticket: chỉ một thành công.&lt;br&gt;Agent tải 2 nhận hai ticket đồng thời: chỉ một thành&lt;br&gt;công, tổng 3. BPMN tổng quan không phải bằng chứng&lt;br&gt;test concurrency hay backend." vertex="1">
          <mxGeometry height="66" width="14" x="1340" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-87" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=4;fontSize=13;" value="Agent tự nhận; thứ tự High/Normal, deadline phản hồi,&lt;br&gt;ngày tạo chỉ là gợi ý. Chỉ In Progress tính tải:&lt;br&gt;&amp;lt;3 nhận, &amp;gt;=3 không nhận; Customer đưa ticket lại&lt;br&gt;In Progress vẫn được phép kể cả quá tải. Giữ một&lt;br&gt;assignee suốt vòng đời." vertex="1">
          <mxGeometry height="80" width="14" x="1800" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-88" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;flipH=1;align=right;labelPosition=left;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingRight=4;fontSize=13;" value="Review không ngắt luồng chính: ticket vẫn tiếp tục khi&lt;br&gt;Manager chờ/ghi phương án. Không có sequence flow vào/ra&lt;br&gt;container và không nối RE tới U2/X4/Closed; RU chỉ đổi&lt;br&gt;dữ liệu review mà X4 đọc, không điều khiển token.&lt;br&gt;Hoàn tất review trong Waiting không tự đổi ticket thành&lt;br&gt;In Progress; C1 vẫn chờ Customer." vertex="1">
          <mxGeometry height="95" width="14" x="1960" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-89" parent="1" style="html=1;shape=mxgraph.flowchart.annotation_2;flipH=1;align=right;labelPosition=left;verticalLabelPosition=middle;verticalAlign=middle;whiteSpace=nowrap;spacingRight=4;fontSize=13;" value="Hai lần từ chối đầu không tạo review; từ lần 3 tạo review&lt;br&gt;mới, lần 4, 5… kích hoạt lại. Tối đa một review mở/ticket;&lt;br&gt;mỗi lượt xử lý tối đa một review. Manager không nhận ticket,&lt;br&gt;không nhắn công khai, không bấm Resolved. Customer không&lt;br&gt;có message flow vào review và không nhận dữ liệu nội bộ." vertex="1">
          <mxGeometry height="80" width="14" x="1960" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="N5xQFqpIoiPfFkRq3-xL-90" edge="1" parent="1" source="N5xQFqpIoiPfFkRq3-xL-73" style="dashed=1;dashPattern=1 4;html=1;endArrow=none;startArrow=none;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=13;" target="N5xQFqpIoiPfFkRq3-xL-6" value="">
